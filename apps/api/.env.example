# Copy to .env and fill in. Never commit the real file.
#
# The transport keys stay server-side. They must not be moved into apps/mobile:
# anything prefixed EXPO_PUBLIC_ ships inside the app bundle and is trivially
# extractable, and NS issues one subscription per account with no published rate
# limit to absorb abuse.

NODE_ENV=development
PORT=3000

# Reverse proxies between a caller and this process, which is what decides
# whether req.ip is the phone or the proxy. The rate limiters key on it, so too
# high lets a caller choose their own key with an X-Forwarded-For header, and too
# low puts everyone behind the proxy in one bucket. Defaults to 1 when NODE_ENV
# is production (nginx owns ingress there) and 0 otherwise.
#
# Left commented out on purpose. This file is copied to make a real .env, and an
# uncommented 0 here would override the production default of 1, putting every
# caller behind nginx into one rate-limit bucket. Uncomment it only to say
# something the default does not.
#
# Do not guess the number. Set IP_DIAGNOSTIC=true below, call GET /api/v1/ip from
# a phone on mobile data, and its `candidates` table says which setting resolves
# to that phone's own address.
# TRUST_PROXY_HOPS=1

# Serves GET /api/v1/ip, which reflects the proxy chain and the request's headers
# back to an unauthenticated caller. That is what makes it answer the question
# above, and what makes it the wrong thing to leave running. Turn it off again
# once TRUST_PROXY_HOPS is settled.
IP_DIAGNOSTIC=false

# MySQL, because the production hosting only offers MySQL.
#
# Defaults below target a local MySQL install. To use the bundled container
# instead, run `docker compose up -d` and set DB_PORT=3307, DB_USER=alarm,
# DB_PASSWORD=alarm, DB_NAME=dynamic_alarm.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=dynamic_alarm_db

# Shared secret for POST /api/v1/monitor/tick. In production the scheduler sends
# it as the X-Monitor-Token header; locally, set anything and send the same value
# when you want to drive a tick by hand. Empty means the route answers 503, which
# is deliberate: an unguarded tick is a stranger's loop spending the NS quota.
MONITOR_TOKEN=local-monitor-token

# apiportal.ns.nl, the `Ns-App` product (self-serve, instant approval).
# Not `Public-Travel-Information`, which contains only the deprecated price API.
NS_SUBSCRIPTION_KEY=

# developer.tomtom.com
TOMTOM_API_KEY=
