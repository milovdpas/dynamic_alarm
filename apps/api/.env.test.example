# Copy to .env.test. Used only when NODE_ENV=test, which vitest sets itself.
#
# Create the database once:
#
#   CREATE DATABASE dynamic_alarm_test CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#
# The suite migrates it on every run and truncates every table before every
# test, so it must be a database whose contents nobody minds losing.
#
# DB_NAME must end in "_test". The test bootstrap refuses to run otherwise, and
# also refuses if this file is missing, because dotenv would then quietly fall
# back to whatever DB_* variables are already in the environment, which on a
# developer machine is usually the development database.

NODE_ENV=test

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=dynamic_alarm_test

# Left empty on purpose. No test calls NS or TomTom: the transport providers are
# replaced with the deterministic fixture from @alarm/core, because a suite that
# depends on a live timetable fails when a train is late, and spends a shared
# budget of 300 requests per 5 minutes to do it. The keys are read lazily, so an
# empty value here costs nothing until something actually tries to use it.
NS_SUBSCRIPTION_KEY=
TOMTOM_API_KEY=
