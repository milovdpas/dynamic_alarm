{
  "name": "@alarm/api",
  "version": "0.1.0",
  "private": true,
  "description": "Journey monitor and device API for the dynamic alarm",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "smoke:transport": "tsx tools/smokeTransport.ts",
    "migrate": "tsx tools/migrate.ts latest",
    "migrate:rollback": "tsx tools/migrate.ts rollback",
    "clean": "rimraf dist",
    "migrate:status": "tsx tools/migrate.ts status",
    "smoke:api": "tsx tools/smokeApi.ts",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@alarm/core": "*",
    "@alarm/types": "*",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "knex": "^3.1.0",
    "luxon": "^3.7.2",
    "mysql2": "^3.23.3",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.27",
    "undici": "^7.16.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.7.0",
    "@types/supertest": "^7.2.1",
    "rimraf": "^6.0.1",
    "supertest": "^7.2.2",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3",
    "vitest": "^3.2.4"
  }
}
