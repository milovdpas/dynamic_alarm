# Deployment template. Committed on purpose, and it holds no secrets.
#
# CI renders it with envsubst, which replaces every $NAME below with the
# matching environment variable and leaves the literal lines alone:
#
#   envsubst < .env.dist > .env
#
# A name that is not set in the environment substitutes to an empty string
# rather than failing, so anything required has to be checked after rendering.
# The two transport keys are the ones that matter: the API starts without them
# and only fails when the first journey is planned, which is the middle of the
# night for whoever is relying on it.

NODE_ENV=production
PORT=3000

# MySQL, because the production hosting offers nothing else.
DB_HOST=$DB_HOST
DB_PORT=$DB_PORT
DB_USER=$DB_USER
DB_PASSWORD=$DB_PASSWORD
DB_NAME=$DB_NAME

# Shared secret for POST /api/v1/monitor/tick, which the Ofelia scheduler calls
# once a minute from inside the container. Nothing else may call it: an open
# tick is a stranger's loop spending this deployment's whole NS quota.
#
# Compose reads this same file for label interpolation, so the value reaches
# both the container's environment and the scheduled command.
MONITOR_TOKEN=$MONITOR_TOKEN

# apiportal.ns.nl, the `Ns-App` product. 300 requests per 5 minutes, shared
# across every user of this deployment.
NS_SUBSCRIPTION_KEY=$NS_SUBSCRIPTION_KEY
NS_BASE_URL=https://gateway.apiportal.ns.nl

# developer.tomtom.com
TOMTOM_API_KEY=$TOMTOM_API_KEY
TOMTOM_BASE_URL=https://api.tomtom.com
